-            if (!(renderer is MeshRenderer || renderer is SkinnedMeshRenderer)
-                || !renderer.enabled || renderer.forceRenderingOff) continue;
-            if (found) bounds.Encapsulate(renderer.bounds); else bounds = renderer.bounds;
-            found = true;
-        }
-        return found && bounds.size.sqrMagnitude > .000000001f;
-    }
