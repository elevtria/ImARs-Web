+using UnityEngine;
+
+// The shared parent stays selectable while its two imported models are exchanged.
+public sealed class VolcanoCutaway : MonoBehaviour
+{
+    public Transform wholeModel;
+    public Transform cutawayModel;
+    [Min(.1f)] public float duration = .7f;
+
+    private Vector3 wholeScale, cutawayScale;
+    private Quaternion wholeRotation, cutawayRotation;
+    private float elapsed;
+    private bool initialized, revealing;
+    private bool playingAuthoredReveal;
+    private float authoredRevealLength;
+    public bool IsRevealed { get; private set; }
+    public bool WasClicked => revealing || IsRevealed;
+    internal bool AnimationPaused { get; set; }
+
+    private void Awake() => Initialize();
+
+    private void Initialize()
+    {
+        if (initialized || !wholeModel || !cutawayModel) return;
+        initialized = true;
+        wholeScale = wholeModel.localScale;
+        cutawayScale = cutawayModel.localScale;
+        wholeRotation = wholeModel.localRotation;
+        cutawayRotation = cutawayModel.localRotation;
+        // Match the bases, preserving the cutaway's authored orientation and size.
+        if (TryBounds(wholeModel, out var whole) && TryBounds(cutawayModel, out var cut))
+            cutawayModel.position += new Vector3(whole.center.x - cut.center.x,
+                whole.min.y - cut.min.y, whole.center.z - cut.center.z);
+        ResetToWhole();
+    }
+
+    private static bool TryBounds(Transform root, out Bounds bounds)
+    {
+        bounds = default;
+        bool found = false;
+        foreach (var renderer in root.GetComponentsInChildren<Renderer>(true))
+        {
+            if (!(renderer is MeshRenderer) && !(renderer is SkinnedMeshRenderer)) continue;
+            // Inactive renderers may not have updated world bounds yet.
+            var local = renderer.localBounds;
+            for (int corner = 0; corner < 8; corner++)
+            {
+                var point = renderer.transform.TransformPoint(local.center + Vector3.Scale(local.extents,
+                    new Vector3((corner & 1) == 0 ? -1 : 1, (corner & 2) == 0 ? -1 : 1,
+                        (corner & 4) == 0 ? -1 : 1)));
+                if (found) bounds.Encapsulate(point); else bounds = new Bounds(point, Vector3.zero);
+                found = true;
+            }
+        }
+        return found;
+    }
+
+    public void Reveal()
+    {
+        Initialize();
+        if (!initialized || IsRevealed || revealing) return;
+        revealing = true;
+        elapsed = 0;
+        // The imported cutaway already animates both halves separating. Replay
+        // that clip explicitly; a quick root turn/model swap hides this action.
+        var animator = cutawayModel.GetComponent<Animator>();
+        playingAuthoredReveal = animator && animator.runtimeAnimatorController;
+        if (playingAuthoredReveal)
+        {
+            wholeModel.gameObject.SetActive(false);
+            cutawayModel.gameObject.SetActive(true);
+            animator.enabled = true;
+            animator.cullingMode = AnimatorCullingMode.AlwaysAnimate;
+            animator.Rebind();
+            animator.Update(0);
+            var state = animator.GetCurrentAnimatorStateInfo(0);
+            animator.Play(state.fullPathHash, 0, 0);
+            animator.Update(0);
+            authoredRevealLength = Mathf.Max(duration, animator.GetCurrentAnimatorStateInfo(0).length);
+        }
+    }
+
+    private void Update()
+    {
+        if (!AnimationPaused) AdvanceAnimation(Time.unscaledDeltaTime);
+    }
+
+    public void AdvanceAnimation(float deltaTime)
+    {
+        if (!revealing) return;
+        elapsed += Mathf.Max(0, deltaTime);
+        if (playingAuthoredReveal)
+        {
+            if (elapsed >= authoredRevealLength)
+            {
+                revealing = false;
+                IsRevealed = true;
+            }
+            return;
+        }
+        // Retain the existing transition for a model without an Animator.
+        float t = Mathf.Clamp01(elapsed / Mathf.Max(.1f, duration));
+        if (t < .4f)
+        {
+            float blend = Mathf.SmoothStep(0, 1, t / .4f);
+            wholeModel.localScale = wholeScale;
+            wholeModel.localRotation = wholeRotation * Quaternion.Euler(0, 20 * blend, 0);
+        }
+        else
+        {
+            wholeModel.gameObject.SetActive(false);
+            cutawayModel.gameObject.SetActive(true);
+            float blend = Mathf.SmoothStep(0, 1, (t - .4f) / .6f);
+            cutawayModel.localScale = cutawayScale;
+            cutawayModel.localRotation = cutawayRotation * Quaternion.Euler(0, -20 * (1 - blend), 0);
+        }
+        if (t >= 1)
+        {
+            revealing = false;
+            IsRevealed = true;
+        }
+    }
+
+    public void ResetToWhole()
+    {
+        if (!initialized) return;
+        revealing = false;
+        playingAuthoredReveal = false;
+        elapsed = 0;
+        IsRevealed = false;
+        wholeModel.localScale = wholeScale;
+        wholeModel.localRotation = wholeRotation;
+        cutawayModel.localScale = cutawayScale;
+        cutawayModel.localRotation = cutawayRotation;
+        wholeModel.gameObject.SetActive(true);
+        cutawayModel.gameObject.SetActive(false);
+    }
+
+    private void OnDisable() => ResetToWhole();
+}
