{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imars-web",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "./dist",
  // Deploy wrangler.web-auth.jsonc to this Cloudflare account before the next
  // production Pages deployment. Adding this binding does not enable login
  // protection or change Firebase rules.
  "env": {
    "production": {
      "vars": {
        "WEB_LOGIN_ENABLED": "true",
        "WEB_DATA_ENABLED": "true",
        "STUDENT_QUIZZES_ENABLED": "true",
        "STUDENT_SCHEDULE_ENABLED": "true",
        "TEACHER_MOBILE_SESSIONS_ENABLED": "true",
        "DASHBOARD_SUMMARIES_ENABLED": "true",
        "TEACHER_SESSION_SYNC_ENABLED": "true",
        "IMARS_SUPABASE_WEB_DATA": "true",
        "IMARS_SUPABASE_URL": "https://ggqgiysotrnukqtzaqxn.supabase.co",
        "IMARS_SUPABASE_APP_DATASET_ID": "f6c5b9bf-7864-4755-803b-8cc31c63bd06"
      },
      "durable_objects": {
        "bindings": [{
          "name": "WEB_LOGIN_STATE",
          "class_name": "WebLoginState",
          "script_name": "imars-web-auth"
        }]
      }
    },
    // Preview uses a separate private Worker and needs its own saved secrets.
    "preview": {
      "vars": { "WEB_LOGIN_ENABLED": "true", "WEB_DATA_ENABLED": "true" },
      "durable_objects": {
        "bindings": [{
          "name": "WEB_LOGIN_STATE",
          "class_name": "WebLoginState",
          "script_name": "imars-web-auth-preview"
        }]
      }
    }
  }
}
