{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imars-web",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "./dist",
  // Deploy wrangler.web-auth.jsonc to this Cloudflare account before the next
  // production Pages deployment. Adding this binding does not enable login
  // protection or change Firebase rules.
  "env": {
    "production": {
      "vars": { "WEB_LOGIN_ENABLED": "true", "WEB_DATA_ENABLED": "true" },
      "durable_objects": {
        "bindings": [{
          "name": "WEB_LOGIN_STATE",
          "class_name": "WebLoginState",
          "script_name": "imars-web-auth"
        }]
      }
    },
    // Preview uses a separate private Worker and needs its own saved secrets.
    "preview": {
      "vars": { "WEB_LOGIN_ENABLED": "true", "WEB_DATA_ENABLED": "true" },
      "durable_objects": {
        "bindings": [{
          "name": "WEB_LOGIN_STATE",
          "class_name": "WebLoginState",
          "script_name": "imars-web-auth-preview"
        }]
      }
    }
  }
}
