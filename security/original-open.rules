// Original owner-supplied rule, retained for diagnosis / emergency recovery.
// INSECURE: it permits public reads and writes until the date below.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 8, 4);
    }
  }
}
