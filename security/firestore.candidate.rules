// MIGRATION CANDIDATE: do not publish until the updated clients, account gateway,
// and independently verified _accountAccess records are ready. See README.md.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function access() {
      return get(/databases/$(database)/documents/_accountAccess/$(request.auth.uid)).data;
    }
    function profile(id) { return get(/databases/$(database)/documents/users/$(id)).data; }
    function validBinding() {
      let binding = access();
      let owner = profile(binding.profileId);
      return binding.active == true && owner.uid == request.auth.uid
        && owner.get('role', 'student') == binding.role && owner.get('active', true) != false
        && owner.get('status', '') != 'inactive';
    }
    function hasAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/_accountAccess/$(request.auth.uid)) && validBinding();
    }
    function isAdmin() { return hasAccount() && access().role == 'admin'; }
    function isTeacher() { return hasAccount() && access().role == 'teacher'; }
    function isStaff() { return hasAccount() && access().role in ['admin', 'teacher']; }
    function ownsProfile(id) { return hasAccount() && access().profileId == id; }
    function student(data) { return data.get('role', 'student') == 'student'; }
    function classOwnedByCaller(id) {
      return id is string && id != ''
        && get(/databases/$(database)/documents/classes/$(id)).data.teacherId == access().profileId;
    }
    function ownsClass(id) { return isTeacher() && classOwnedByCaller(id); }
    function studentAssignedToCaller(data) {
      return student(data) && (data.get('teacherId', '') == access().profileId || classOwnedByCaller(data.get('classCode', '')));
    }
    function unchangedIdentity(id) {
      return request.resource.data.get('uid', '') == resource.data.get('uid', '')
        && request.resource.data.get('role', 'student') == resource.data.get('role', 'student')
        && request.resource.data.get('schoolId', id) == resource.data.get('schoolId', id);
    }
    function studentProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarId', 'hasSeenClassCode', 'gamification'])
        && request.resource.data.get('avatarId', '') is string
        && request.resource.data.get('avatarId', '').size() <= 100
        && request.resource.data.get('hasSeenClassCode', false) is bool
        && request.resource.data.get('gamification', {}) is map
        && request.resource.data.get('gamification', {}).diff(resource.data.get('gamification', {})).affectedKeys().hasOnly(['totalPoints', 'badgeCounts']);
    }
    function score(data, prefix) {
      return (!data.keys().hasAny([prefix + 'Score']) ||
        (data[prefix + 'Score'] is int && data[prefix + 'Score'] >= 0 && data[prefix + 'Score'] <= data.get(prefix + 'TotalQuestions', 100)))
        && (!data.keys().hasAny([prefix + 'TotalQuestions']) ||
          (data[prefix + 'TotalQuestions'] is int && data[prefix + 'TotalQuestions'] >= 0 && data[prefix + 'TotalQuestions'] <= 100))
        && (!data.keys().hasAny([prefix + 'Heatmap']) || (data[prefix + 'Heatmap'] is list && data[prefix + 'Heatmap'].size() <= 100));
    }
    function resultShape(data) {
      return score(data, 'preTest') && score(data, 'postTest')
        && data.get('isPreTestCompleted', false) is bool && data.get('isPostTestCompleted', false) is bool
        && data.get('isLessonCompleted', false) is bool && data.get('isARCompleted', false) is bool
        && data.get('arTimeMinutes', 0) is number && data.get('arTimeMinutes', 0) >= 0
        && data.get('lessonTimeMinutes', 0) is number && data.get('lessonTimeMinutes', 0) >= 0
        && data.get('arNavigationTimeMinutes', 0) is number && data.get('arNavigationTimeMinutes', 0) >= 0
        && data.get('learningTimeByDevice', {}) is map;
    }
    function resultFields() {
      return ['lessonId', 'termId', 'timestamp', 'totalQuestions', 'preTestScore', 'preTestHeatmap', 'preTestTotalQuestions',
        'postTestScore', 'postTestHeatmap', 'postTestTotalQuestions', 'isPreTestCompleted', 'isPostTestCompleted',
        'isLessonCompleted', 'isARCompleted', 'arTimeMinutes', 'lessonTimeMinutes', 'arNavigationTimeMinutes', 'learningTimeByDevice'];
    }
    function resultWriter(id) {
      return hasAccount() && (access().role == 'admin' || (access().profileId == id && access().role == 'student')
        || (access().role == 'teacher' && studentAssignedToCaller(profile(id))));
    }
    function userUpdate(id) {
      let binding = access();
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (binding.role == 'admin' && (resource.data.get('role', 'student') in ['student', 'teacher'] ||
        (binding.profileId == id && changed.hasOnly([
          'schoolId', 'roleLabel', 'displayName', 'fullName', 'providedEmail', 'email', 'school', 'department', 'phone', 'updatedAt']))))
        || (binding.role == 'teacher' && binding.profileId == id && changed.hasOnly(['sections']))
        || (binding.role == 'teacher' && studentAssignedToCaller(resource.data) && classOwnedByCaller(request.resource.data.get('classCode', ''))
          && changed.hasOnly(['schoolId', 'role', 'firstName', 'lastName', 'displayName', 'fullName', 'classCode', 'section', 'teacherId',
            'providedEmail', 'email', 'avatarId', 'active', 'updatedAt', 'lastQrSyncAt'])
          && request.resource.data.get('teacherId', binding.profileId) == binding.profileId)
        || (binding.profileId == id && binding.role == 'student' && studentProfileFields());
    }

    // Only the trusted enrollment server / maintenance tooling writes identity
    // bindings. A client-written role never grants staff authority.
    match /_accountAccess/{uid} { allow read, write: if false; }

    match /users/{id} {
      allow get: if ownsProfile(id) || isAdmin() || (isTeacher() && (resource == null || student(resource.data)));
      // Keep the app's actual UID queries and the staff's school-wide student
      // reports. The latter are intentional legacy permissions, not per-class.
      allow list: if isAdmin() || (isTeacher() && resource.data.role == 'student')
        || (hasAccount() && resource.data.uid == request.auth.uid);
      allow create: if hasAccount() && !request.resource.data.keys().hasAny(['uid']) && (
        (access().role == 'admin' && request.resource.data.get('role', 'student') in ['student', 'teacher'])
        || (access().role == 'teacher' && student(request.resource.data) && classOwnedByCaller(request.resource.data.get('classCode', '')))
      );
      allow update: if hasAccount() && unchangedIdentity(id) && userUpdate(id);
      allow delete: if isAdmin() && resource.data.role in ['student', 'teacher'];

      // Generated quiz attempts contain private grading data. All operations
      // go through the authenticated API, including reads and teacher review.
      match /generated_quiz_attempts/{attempt} { allow read, write: if false; }
      match /test_results/{term} {
        allow read: if ownsProfile(id) || (isStaff() && student(profile(id)));
        allow write: if false;
        match /lessons/{lesson} {
          allow read: if ownsProfile(id) || (isStaff() && student(profile(id)));
          allow create: if resultWriter(id) && request.resource.data.keys().hasOnly(resultFields()) && resultShape(request.resource.data);
          allow update: if resultWriter(id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(resultFields()) && resultShape(request.resource.data);
          allow delete: if isAdmin();
        }
      }
      match /recent_scans/{scan} {
        allow read, delete: if isAdmin() || (isTeacher() && ownsProfile(id));
        allow create: if (isAdmin() || (isTeacher() && ownsProfile(id)))
          && request.resource.data.keys().hasOnly(['moduleName', 'scanType', 'timestamp'])
          && request.resource.data.moduleName is string && request.resource.data.moduleName.size() <= 500
          && request.resource.data.scanType == 'qr' && request.resource.data.timestamp == request.time;
      }
      match /offlineSync/{document} {
        allow read: if isAdmin() || (isTeacher() && ownsProfile(id));
        allow create, update: if document == 'markerDownloads' && (isAdmin() || (isTeacher() && ownsProfile(id)))
          && request.resource.data.keys().hasOnly(['requestedFiles', 'updatedAt'])
          && request.resource.data.requestedFiles is list && request.resource.data.requestedFiles.size() <= 100
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /classes/{id} {
      allow read: if isStaff() || (hasAccount() && profile(access().profileId).get('classCode', '') == id);
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == access().profileId);
      allow update: if isAdmin() || (ownsClass(id) && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin() || ownsClass(id);
    }
    match /terms/{term} {
      allow read: if hasAccount();
      allow write: if false;
      match /lessons/{lesson} {
        allow read: if hasAccount();
        allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isLocked', 'scheduledDate'])
          && request.resource.data.isLocked is bool && request.resource.data.scheduledDate is string
          && (request.resource.data.scheduledDate == '' || request.resource.data.scheduledDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
    }
    match /did_you_know/{id} { allow read: if hasAccount(); }
    match /generatedQuizzes/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isTeacher() && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherProfileId == access().profileId && ownsClass(request.resource.data.sectionId);
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.teacherProfileId == access().profileId && ownsClass(request.resource.data.sectionId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    match /webSettings/schoolYear {
      allow read: if hasAccount();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['startYear', 'endYear', 'updatedBy', 'updatedAt'])
        && request.resource.data.startYear is int && request.resource.data.startYear >= 2000 && request.resource.data.startYear <= 2100
        && request.resource.data.endYear == request.resource.data.startYear + 1
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
