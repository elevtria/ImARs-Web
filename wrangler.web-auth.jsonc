{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imars-web-auth",
  "main": "workers/web-auth-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "WEB_LOGIN_STATE", "class_name": "WebLoginState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WebLoginState"] }]
}
